#!/usr/bin/env bash
# agentbox: default-deny sandbox for AI coding agents, VS Code and Remote-SSH
# sessions. Needs bash + coreutils + /usr/bin/python3 + one backend:
#   bwrap   (preferred: mount/pid/ipc namespaces; real paths are invisible)
#   landlock (fallback when user namespaces are blocked; weaker)
# Both add a seccomp filter and, where the kernel allows, Landlock port rules.
# Never falls back to running unsandboxed.
set -euo pipefail
umask 077

die() { echo "agentbox: FAIL CLOSED: $*" >&2; exit 1; }
usage() {
  cat >&2 <<'EOF'
Usage:
  agentbox [OPTIONS] PROJECT [-- CMD [ARGS...]]
                         run CMD (default: $SHELL) with PROJECT read-write
  agentbox setup         download the shared VS Code (tarball, no sudo) once
  agentbox ext CODE_CLI_ARGS...
                         manage the shared extensions, e.g.
                         ext --install-extension anthropic.claude-code
                         ext --update-extensions | ext --list-extensions
  agentbox code [OPTIONS] PROJECT
                         run the shared VS Code + extensions (read-only) sandboxed
  agentbox gate PROJECT [OPTIONS]
                         SSH forced command; see README (remote side)
  agentbox git [-C DIR] GIT_ARGS...
                         host-side git for agent-touched repos: refuses repo config
                         that runs commands, never runs hooks
  agentbox check [PROJECT]
                         prove the sandbox holds (files, env, syscalls, git, network)
  agentbox adduser NAME [PROJECT...]
                         (sudo) create a dedicated agent account with access to PROJECTs
Options:
  --ro PATH | --rw PATH  extra grant (home, secrets and personal folders are refused)
  --mask PATH            hide a file/dir inside a grant, e.g. --mask app/.env (bwrap)
  --allow-personal       allow granting a subfolder of Documents, Downloads, ...
  --net MODE             auto (default) | web | proxy | open, see README
  --port N[-M]           extra TCP ports for --net web
  --allow-host HOST      extra host for --net proxy (also: ~/.local/share/agentbox/allowlist)
Env: AGENTBOX_BACKEND=auto|bwrap|landlock  AGENTBOX_PROFILE=name (shared agent home)
EOF
  exit 2
}

REAL_HOME=$HOME
STATE=$HOME/.local/share/agentbox   # not XDG_DATA_HOME: snaps repoint it per revision
VSCODE=$STATE/vscode                # one VS Code for all sandboxes
EXTS=$STATE/extensions              # one extension set for all sandboxes
# Absolute paths only: the sandbox's PATH starts with the agent-writable
# ~/.local/bin, and anything resolved through it would run unsandboxed.
PY=/usr/bin/python3
[[ -x $PY ]] || die "$PY not found (needed for seccomp and landlock)"
BWRAP=$(command -v bwrap 2>/dev/null) || BWRAP=''

inside() { [[ $1 == "$2" || $1 == "$2"/* ]]; }   # is $1 equal to or below $2?

# Never grantable, nor anything inside them or containing them: agentbox state,
# credentials, and files the host executes (shell rc, ~/.local/bin).
# Personal folders (XDG user dirs) are never granted whole; a subfolder needs
# --allow-personal.
protected_paths() {
  local d key val f=${XDG_CONFIG_HOME:-$REAL_HOME/.config}/user-dirs.dirs
  SECRET=("$STATE")
  for d in .ssh .gnupg .aws .azure .kube .docker .password-store .pki .mozilla .thunderbird \
           .config .local/share/keyrings .local/bin bin .netrc .git-credentials .gitconfig \
           .bashrc .bash_profile .bash_login .profile .zshrc .zprofile .bash_history .zsh_history; do
    SECRET+=("$(realpath -m -- "$REAL_HOME/$d")")
  done
  PERSONAL=()
  for d in Desktop Documents Downloads Music Pictures Videos Public Templates; do
    PERSONAL+=("$(realpath -m -- "$REAL_HOME/$d")")
  done
  if [[ -r $f ]]; then
    while IFS='=' read -r key val; do
      [[ $key == XDG_*_DIR ]] || continue
      val=${val//\"/}; val=${val/#\$HOME/$REAL_HOME}; val=$(realpath -m -- "$val")
      if [[ $val == /* && $val != "$REAL_HOME" && " ${PERSONAL[*]} " != *" $val "* ]]; then PERSONAL+=("$val"); fi
    done <"$f"
  fi
}

check_grant() {
  local p=$1 s
  [[ $p != / ]] || die "refusing to grant /"
  if inside "$REAL_HOME" "$p"; then die "refusing to grant $p (contains your home)"; fi
  for s in "${SECRET[@]}"; do
    if inside "$p" "$s" || inside "$s" "$p"; then die "refusing to grant $p (protected: $s)"; fi
  done
  for s in "${PERSONAL[@]}"; do
    if inside "$s" "$p"; then die "refusing to grant $p (personal folder $s)"; fi
    if inside "$p" "$s" && ((!ALLOW_PERSONAL)); then
      die "refusing to grant $p (inside personal folder $s; add --allow-personal to grant a subfolder)"
    fi
  done
}

RO=() RW=() MASK=() HOSTS=() EXTRA_PORTS=() NET=auto ALLOW_PERSONAL=0 SECCOMP=strict
parse_grants() {  # sets RO, RW, MASK, NET, PROJECT, CMD, ...
  PROJECT='' CMD=()
  local p m
  while (($#)); do
    case $1 in
      --ro) RO+=("$(realpath -e -- "${2:-}")") || die "no such path: ${2:-}"; shift 2 ;;
      --rw) RW+=("$(realpath -e -- "${2:-}")") || die "no such path: ${2:-}"; shift 2 ;;
      --mask) MASK+=("$(realpath -e -- "${2:-}")") || die "no such path: ${2:-}"; shift 2 ;;
      --net) NET=${2:-}; shift 2 ;;
      --port) [[ ${2:-} =~ ^[0-9]+(-[0-9]+)?$ ]] || die "bad port: ${2:-}"; EXTRA_PORTS+=("$2"); shift 2 ;;
      --allow-host) [[ ${2:-} =~ ^[A-Za-z0-9*.:-]+$ ]] || die "bad host: ${2:-}"; HOSTS+=("$2"); shift 2 ;;
      --allow-personal) ALLOW_PERSONAL=1; shift ;;
      --) shift; CMD=("$@"); break ;;
      -*) usage ;;
      *) [[ -z $PROJECT ]] || usage; PROJECT=$(realpath -e -- "$1") || die "no such dir: $1"; shift ;;
    esac
  done
  [[ -n $PROJECT && -d $PROJECT ]] || usage
  protected_paths
  for p in "$PROJECT" "${RW[@]}" "${RO[@]}"; do check_grant "$p"; done
  for m in "${MASK[@]}"; do
    local ok=0
    for p in "$PROJECT" "${RW[@]}" "${RO[@]}"; do if inside "$m" "$p" && [[ $m != "$p" ]]; then ok=1; fi; done
    ((ok)) || die "--mask $m is not inside a granted path"
  done
}

# Per-project agent home: agent logins, ~/.vscode-server, caches live here.
# Separate projects cannot read or poison each other's agent home.
agent_home() {
  local name=${AGENTBOX_PROFILE:-$(basename "$PROJECT")-$(printf %s "$PROJECT" | sha256sum | cut -c1-8)}
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "bad profile name: $name"
  AHOME=$STATE/$name/home
  mkdir -p "$AHOME/.local/bin" "$AHOME/tmp"
}

# Environment is rebuilt from a whitelist: tokens in env (AWS_*, GH_TOKEN,
# SSH_AUTH_SOCK, DBUS_SESSION_BUS_ADDRESS, ...) never reach the sandbox.
base_env() {
  ENV=(env -i HOME="$REAL_HOME" USER="${USER:-$(id -un)}" LOGNAME="${USER:-$(id -un)}"
       SHELL=/bin/bash TERM="${TERM:-dumb}" LANG="${LANG:-C.UTF-8}" TMPDIR="$REAL_HOME/tmp"
       PATH="$REAL_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
       AGENTBOX=1)
  [[ -z ${COLORTERM:-} ]] || ENV+=(COLORTERM="$COLORTERM")
  [[ -z ${TZ:-} ]] || ENV+=(TZ="$TZ")
}

LL_ABI=$("$PY" -I -c 'import ctypes;print(ctypes.CDLL(None).syscall(444,None,0,1))' 2>/dev/null) || LL_ABI=0
((LL_ABI > 0)) || LL_ABI=0
have_bwrap() { [[ -n $BWRAP ]] && "$BWRAP" --ro-bind / / --unshare-user --unshare-pid true 2>/dev/null; }
have_landlock() { ((LL_ABI >= 1)); }
pick_backend() {
  case ${AGENTBOX_BACKEND:-auto} in
    bwrap) have_bwrap || die 'bwrap unusable (missing or user namespaces blocked)'; BACKEND=bwrap ;;
    landlock) have_landlock || die 'landlock unavailable (needs kernel >= 5.13)'; BACKEND=landlock ;;
    auto) if have_bwrap; then BACKEND=bwrap
          elif have_landlock; then BACKEND=landlock
            echo 'agentbox: WARNING: bwrap unusable, using weaker landlock backend' >&2
          else die 'neither bwrap nor landlock is usable; ask an admin (see README)'; fi ;;
    *) die "unknown AGENTBOX_BACKEND" ;;
  esac
}

# Network modes: open = anything the host reaches; web = TCP connect only to
# 443/80/53/22, the ephemeral range (IDE, debugger and forwarded ports) and
# --port grants, which keeps local databases, Docker and dev servers out;
# proxy = no network but an allowlisting HTTPS proxy outside the sandbox.
resolve_net() {
  case $NET in
    auto) if ((LL_ABI >= 4)); then NET=web; else NET=open
            echo 'agentbox: WARNING: kernel < 6.7 cannot restrict ports; network is open' >&2; fi ;;
    web) ((LL_ABI >= 4)) || die '--net web needs Landlock ABI 4 (kernel >= 6.7)' ;;
    proxy) [[ $BACKEND == bwrap ]] || die '--net proxy needs the bwrap backend' ;;
    open) ;;
    *) die "unknown --net mode: $NET (auto|web|proxy|open)" ;;
  esac
}
web_ports() {
  local lo hi p out=443,80,53,22
  read -r lo hi </proc/sys/net/ipv4/ip_local_port_range
  out+=",$lo-$hi"
  for p in "${EXTRA_PORTS[@]}"; do out+=",$p"; done
  echo "$out"
}

DEFAULT_ALLOW='# Hosts reachable with --net proxy (HTTPS CONNECT, port 443 unless "host:port").
# "example.com" = exactly that host, "*.example.com" = any subdomain.
# Edit outside the sandbox; changes apply to new connections immediately.
api.anthropic.com
*.anthropic.com
claude.ai
*.claude.ai
api.openai.com
*.openai.com
chatgpt.com
*.chatgpt.com
github.com
api.github.com
codeload.github.com
*.githubusercontent.com
registry.npmjs.org
pypi.org
files.pythonhosted.org
marketplace.visualstudio.com
*.gallery.vsassets.io
*.gallerycdn.vsassets.io'

# Starts the allowlisting proxy on a Unix socket outside the sandbox. It exits
# when this process (which becomes bwrap) does.
start_proxy() {
  local run i allow=$STATE/allowlist
  [[ -e $allow ]] || printf '%s\n' "$DEFAULT_ALLOW" >"$allow"
  run=$(mktemp -d "${AHOME%/home}/run.XXXXXX")
  PROXY_SOCK=$run/proxy.sock
  "$PY" -I -c "$PUMP_PY$PROXY_PY" "$PROXY_SOCK" "$allow" "${AHOME%/home}/proxy.log" $$ "${HOSTS[@]}" \
    </dev/null >/dev/null 2>&1 &
  for ((i = 0; i < 100; i++)); do [[ -S $PROXY_SOCK ]] && return; sleep 0.02; done
  die 'proxy did not start'
}

# Git runs code named in .git/config and .git/hooks with your full rights when
# you use the repo outside the sandbox. Make those read-only, and bind .git onto
# itself: a mount point cannot be renamed away and replaced by a fake .git.
git_protect() {  # appends to the caller's bwrap array `a`
  local root g sub f
  for root in "$@"; do
    while IFS= read -r -d '' g; do
      [[ -d $g ]] || continue
      mkdir -p "$g/hooks" "$g/info"
      a+=(--bind "$g" "$g")
      for f in config config.worktree hooks info; do [[ ! -e $g/$f ]] || a+=(--ro-bind "$g/$f" "$g/$f"); done
      # submodule repos keep their own config and hooks under .git/modules/
      while IFS= read -r -d '' sub; do
        sub=${sub%/config}; mkdir -p "$sub/hooks"
        a+=(--bind "$sub" "$sub" --ro-bind "$sub/config" "$sub/config" --ro-bind "$sub/hooks" "$sub/hooks")
      done < <(find "$g/modules" -name config -type f -print0 2>/dev/null)
    done < <(find "$root" -maxdepth 3 \( -name node_modules -o -name .venv \) -prune -o -name .git -print0 -prune 2>/dev/null)
  done
}
has_git_repo() {
  local root
  for root in "$@"; do
    [[ -z $(find "$root" -maxdepth 3 \( -name node_modules -o -name .venv \) -prune -o -name .git -print -quit 2>/dev/null) ]] || return 0
  done
  return 1
}

# exec_sandboxed EXTRA_BWRAP_ARGS_ARRAY_NAME CMD...
exec_sandboxed() {
  local -n extra=$1; shift
  local p stub=(--seccomp "$SECCOMP")
  ENV+=(AGENTBOX_NET="$NET")
  case $NET in
    web) stub+=(--ports "$(web_ports)") ;;
    proxy) start_proxy
           stub+=(--forward /run/agentbox/proxy.sock)
           ENV+=(HTTPS_PROXY=http://127.0.0.1:3128 https_proxy=http://127.0.0.1:3128
                 HTTP_PROXY=http://127.0.0.1:3128 http_proxy=http://127.0.0.1:3128
                 NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1) ;;
  esac
  if [[ $BACKEND == bwrap ]]; then
    # TIOCSTI keystroke injection is blocked by the seccomp filter, so the
    # sandbox keeps the caller's terminal (job control, Ctrl-C).
    local a=(--die-with-parent --unshare-all --hostname agentbox
             --ro-bind /usr /usr --ro-bind /etc /etc --proc /proc --dev /dev
             --ro-bind-try /run/systemd/resolve /run/systemd/resolve
             --tmpfs /tmp --tmpfs "$REAL_HOME" --bind "$AHOME" "$REAL_HOME")
    if [[ $NET == proxy ]]; then a+=(--ro-bind "$PROXY_SOCK" /run/agentbox/proxy.sock); else a+=(--share-net); fi
    for p in /bin /sbin /lib /lib32 /lib64 /libx32; do
      if [[ -L $p ]]; then a+=(--symlink "$(readlink "$p")" "$p")
      elif [[ -d $p ]]; then a+=(--ro-bind "$p" "$p"); fi
    done
    for p in "${RO[@]}"; do a+=(--ro-bind "$p" "$p"); done
    for p in "${RW[@]}" "$PROJECT"; do a+=(--bind "$p" "$p"); done
    git_protect "${RW[@]}" "$PROJECT"
    # binds are nodev, so a masked file becomes an empty regular file, not /dev/null
    [[ -e $STATE/empty ]] || : >"$STATE/empty"
    for p in "${MASK[@]}"; do
      if [[ -d $p ]]; then a+=(--tmpfs "$p" --remount-ro "$p"); else a+=(--ro-bind "$STATE/empty" "$p"); fi
    done
    exec "${ENV[@]}" "$BWRAP" "${a[@]}" "${extra[@]}" --chdir "$PROJECT" -- \
      "$PY" -I -c "$NR_PY$STUB_PY" "${stub[@]}" -- "$@"
  else
    # Landlock: paths stay visible but every access outside the grants is denied.
    ((${#MASK[@]} == 0)) || die '--mask needs the bwrap backend'
    if has_git_repo "${RW[@]}" "$PROJECT"; then
      echo 'agentbox: WARNING: landlock cannot make .git/config and .git/hooks read-only;' \
           'outside the sandbox use "agentbox git" instead of git for this repo' >&2
    fi
    local a=(--ro /usr --ro /etc --ro /proc --ro /sys --dev /dev)
    for p in /bin /sbin /lib /lib32 /lib64 /libx32 /run/systemd/resolve; do [[ -e $p ]] && a+=(--ro "$p"); done
    for p in "${RO[@]}"; do a+=(--ro "$p"); done
    for p in "${RW[@]}" "$PROJECT"; do a+=(--rw "$p"); done
    cd "$PROJECT"
    exec "${ENV[@]}" HOME="$AHOME" TMPDIR="$AHOME/tmp" PATH="$AHOME/.local/bin:/usr/local/bin:/usr/bin:/bin" \
      "$PY" -I -c "$NR_PY$STUB_PY" "${a[@]}" --rw "$AHOME" "${stub[@]}" -- "$@"
  fi
}

