PUMP_PY='
import socket, threading
def pump(a, b):
    try:
        while True:
            d = a.recv(65536)
            if not d: break
            b.sendall(d)
    except OSError: pass
    try: b.shutdown(socket.SHUT_WR)
    except OSError: pass
def splice(a, b, first=b""):
    try:
        if first: b.sendall(first)
        t = threading.Thread(target=pump, args=(b, a), daemon=True); t.start()
        pump(a, b); t.join()
    finally:
        a.close(); b.close()
'

# Runs inside the sandbox right before the agent: Landlock (files for the
# landlock backend, TCP ports for --net web), seccomp, the proxy forwarder.
STUB_PY=$PUMP_PY'
import ctypes, struct, sys
def fail(msg): sys.exit("agentbox: FAIL CLOSED: " + msg)
libc = ctypes.CDLL(None, use_errno=True)
sc = libc.syscall; sc.restype = ctypes.c_long
args = sys.argv[1:]; i = args.index("--"); opts, cmd = args[:i], args[i + 1:]
fs, ports, mode, fwd = [], [], "strict", None
for k, v in zip(opts[::2], opts[1::2]):
    if k in ("--ro", "--rw", "--dev"): fs.append((k, v))
    elif k == "--seccomp": mode = v
    elif k == "--forward": fwd = v
    elif k == "--ports":
        for r in v.split(","):
            lo, _, hi = r.partition("-")
            ports += range(int(lo), int(hi or lo) + 1)
    else: fail("bad stub option " + k)

abi = sc(444, None, 0, 1)
hfs = hnet = scoped = 0
if fs:
    if abi < 1: fail("landlock unavailable")
    hfs = (1 << 13) - 1 | (1 << 13 if abi >= 2 else 0) | (1 << 14 if abi >= 3 else 0) | (1 << 15 if abi >= 5 else 0)
if ports:
    if abi < 4: fail("landlock port rules need kernel >= 6.7")
    hnet = 2                                                 # connect_tcp
if abi >= 6: scoped = 3                                      # abstract unix sockets + signals
if hfs or hnet or scoped:
    attr = struct.pack("QQQ", hfs, hnet, scoped) if abi >= 6 else struct.pack("QQ", hfs, hnet) if abi >= 4 else struct.pack("Q", hfs)
    fd = sc(444, attr, len(attr), 0)
    if fd < 0: fail("landlock_create_ruleset failed")
    FILE_BITS = 1 | 2 | 4 | (1 << 14 if abi >= 3 else 0)   # exec, write, read, truncate
    RO = 1 | 4 | 8                                          # exec, read file, read dir
    DEV = RO | 2 | (1 << 15 if abi >= 5 else 0)             # /dev/null, /dev/tty
    for kind, path in fs:
        acc = {"--ro": RO, "--rw": hfs, "--dev": DEV}[kind]
        pfd = os.open(path, os.O_PATH | os.O_CLOEXEC)
        if not os.path.isdir(path): acc &= FILE_BITS
        if sc(445, fd, 1, struct.pack("=Qi", acc, pfd), 0) != 0: fail("landlock_add_rule " + path)
        os.close(pfd)
    for p in sorted(set(ports)):
        if sc(445, fd, 2, struct.pack("=QQ", 2, p), 0) != 0: fail("landlock port rule %d" % p)
if libc.prctl(38, 1, 0, 0, 0) != 0: fail("no_new_privs")
if (hfs or hnet or scoped) and sc(446, fd, 0) != 0: fail("landlock_restrict_self failed")

# seccomp: deny kernel attack surface and same-UID escape hatches (keyring,
# ptrace, namespaces, TIOCSTI). "gui" keeps namespaces for Chromium sandboxes.
if NR is None: fail("seccomp: unsupported architecture " + os.uname().machine)
LD, JEQ, JGE, JSET, RET = 0x20, 0x15, 0x35, 0x45, 0x06
ALLOW, KILL, EPERM, ENOSYS = 0x7FFF0000, 0x80000000, 0x50001, 0x50026
x86 = os.uname().machine == "x86_64"
prog = []
def op(code, k, jt=0, jf=0): prog.append(struct.pack("HBBI", code, jt, jf, k))
op(LD, 4); op(JEQ, 0xC000003E if x86 else 0xC00000B7, 1, 0); op(RET, KILL)
op(LD, 0)
if x86: op(JGE, 0x40000000, 0, 1); op(RET, EPERM)           # x32 ABI
BLOCK = ["ptrace", "process_vm_readv", "process_vm_writev", "keyctl", "add_key", "request_key",
         "bpf", "userfaultfd", "perf_event_open", "kexec_load", "kexec_file_load", "mount", "umount2",
         "pivot_root", "chroot", "init_module", "finit_module", "delete_module", "open_by_handle_at",
         "swapon", "swapoff", "reboot", "acct", "syslog", "quotactl", "lookup_dcookie", "iopl", "ioperm",
         "uselib", "io_uring_setup", "io_uring_enter", "io_uring_register", "open_tree", "move_mount",
         "fsopen", "fsconfig", "fsmount", "fspick", "mount_setattr"]
if mode != "gui": BLOCK.append("setns")
for name in BLOCK:
    if name in NR: op(JEQ, NR[name], 0, 1); op(RET, EPERM)
op(JEQ, NR["clone3"], 0, 1); op(RET, ENOSYS)                  # flags hidden in a struct; libc falls back to clone
if mode != "gui":
    for name in ("clone", "unshare"):                         # no new namespaces of any kind
        op(JEQ, NR[name], 0, 4); op(LD, 16); op(JSET, 0x7E020000, 0, 1); op(RET, EPERM); op(RET, ALLOW)
op(JEQ, NR["ioctl"], 0, 5); op(LD, 24)                         # TIOCSTI, TIOCLINUX
op(JEQ, 0x5412, 1, 0); op(JEQ, 0x541C, 0, 1); op(RET, EPERM); op(RET, ALLOW)
op(RET, ALLOW)
class FProg(ctypes.Structure): _fields_ = [("len", ctypes.c_ushort), ("filter", ctypes.c_void_p)]
buf = ctypes.create_string_buffer(b"".join(prog))
if libc.prctl(22, 2, ctypes.byref(FProg(len(prog), ctypes.addressof(buf))), 0, 0) != 0: fail("seccomp")

# --net proxy: 127.0.0.1:3128 inside the sandbox -> the host proxy socket.
if fwd:
    ls = socket.socket(); ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    ls.bind(("127.0.0.1", 3128)); ls.listen(64)
    pid = os.fork()
    if pid == 0:
        os.setsid()
        if os.fork(): os._exit(0)
        null = os.open("/dev/null", os.O_RDWR)
        for f in (0, 1, 2): os.dup2(null, f)
        def serve(c):
            u = socket.socket(socket.AF_UNIX)
            try: u.connect(fwd)
            except OSError: c.close(); return
            splice(c, u)
        while True:
            c, _ = ls.accept()
            threading.Thread(target=serve, args=(c,), daemon=True).start()
    os.waitpid(pid, 0); ls.close()
os.execvp(cmd[0], cmd)
'

# Host side of --net proxy: HTTPS CONNECT to allowlisted hosts only, logged.
PROXY_PY='
import os, sys, time
sock_path, allow_file, log_path, watch = sys.argv[1:5]
extra = sys.argv[5:]
lock = threading.Lock()
def log(verdict, target):
    with lock, open(log_path, "a") as f:
        f.write("%s %s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), verdict, target))
def allowed(host, port):
    pats = list(extra)
    try:
        with open(allow_file) as f: pats += [l.split("#")[0].strip() for l in f]
    except OSError: pass
    host = host.lower().rstrip(".")
    for p in filter(None, pats):
        hp, _, pp = p.lower().partition(":")
        if port != (int(pp) if pp.isdigit() else 443): continue
        if hp == host or (hp.startswith("*.") and host.endswith(hp[1:])): return True
    return False
def handle(c):
    try:
        c.settimeout(30); buf = b""
        while b"\r\n\r\n" not in buf:
            d = c.recv(4096)
            if not d or len(buf) > 16384: c.close(); return
            buf += d
        head, rest = buf.split(b"\r\n\r\n", 1)
        parts = head.split(b"\r\n")[0].decode("latin-1").split()
        if len(parts) != 3 or parts[0] != "CONNECT":
            log("DENY", "non-CONNECT " + " ".join(parts[:2]))
            c.sendall(b"HTTP/1.1 405 Only HTTPS CONNECT allowed\r\nContent-Length: 0\r\n\r\n"); c.close(); return
        host, _, port = parts[1].rpartition(":")
        host = host.strip("[]"); port = int(port)
        if not allowed(host, port):
            log("DENY", parts[1])
            c.sendall(b"HTTP/1.1 403 Host not in agentbox allowlist\r\nContent-Length: 0\r\n\r\n"); c.close(); return
        u = socket.create_connection((host, port), timeout=15)
        log("ALLOW", parts[1])
        c.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
        c.settimeout(None); u.settimeout(None)
        splice(c, u, rest)
    except (OSError, ValueError):
        try: c.sendall(b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n\r\n")
        except OSError: pass
        c.close()
def watchdog():
    while True:
        time.sleep(1)
        try: os.kill(int(watch), 0)
        except ProcessLookupError:
            try: os.unlink(sock_path); os.rmdir(os.path.dirname(sock_path))
            except OSError: pass
            os._exit(0)
        except PermissionError: pass
s = socket.socket(socket.AF_UNIX); s.bind(sock_path); s.listen(64)
threading.Thread(target=watchdog, daemon=True).start()
while True:
    c, _ = s.accept()
    threading.Thread(target=handle, args=(c,), daemon=True).start()
'

cmd_run() {
  parse_grants "$@"; agent_home; base_env; pick_backend; resolve_net
  ((${#CMD[@]})) || CMD=(/bin/bash -l)
  local none=()
  exec_sandboxed none "${CMD[@]}"
}

# VS Code and extensions are shared by every sandbox but mounted read-only at
# fixed paths, so an agent can neither tamper with them nor see other profiles.
VS_IN=/opt/vscode EXT_IN=/opt/vscode-extensions
vscode_mounts() {  # $1 = ro|rw for the extensions dir; sets X and BIN
  local src
  if [[ -x $VSCODE/bin/code ]]; then src=$VSCODE
  else
    src=$(realpath -e "$(command -v code 2>/dev/null)" 2>/dev/null) || src=''
    [[ $src == /usr/* ]] || die "no usable VS Code (snap cannot be sandboxed); run: agentbox setup"
    src=${src%/bin/*}
  fi
  mkdir -p "$EXTS"
  X=(--ro-bind "$src" "$VS_IN")
  if [[ $1 == rw ]]; then X+=(--bind "$EXTS" "$EXT_IN"); else X+=(--ro-bind "$EXTS" "$EXT_IN"); fi
  BIN=$VS_IN/bin/code
}

cmd_setup() {
  [[ ! -e $VSCODE ]] || { echo "already installed: $VSCODE (delete it to reinstall/upgrade)"; return; }
  local arch; case $(uname -m) in x86_64) arch=x64 ;; aarch64) arch=arm64 ;; *) die "unsupported arch" ;; esac
  local tmp; tmp=$(mktemp -d "$STATE.dl.XXXXXX")
  echo "downloading VS Code ($arch) to $VSCODE ..."
  curl -fsSL "https://update.code.visualstudio.com/latest/linux-$arch/stable" | tar -xz -C "$tmp" || { rm -rf "$tmp"; die 'download failed'; }
  mkdir -p "$STATE"; mv "$tmp"/VSCode-linux-* "$VSCODE"; rmdir "$tmp"
  echo "installed: $("$VSCODE/bin/code" --version | head -1). Next: agentbox ext --install-extension anthropic.claude-code"
}

# Extension admin sandbox: sees no project, only the shared extensions dir (rw).
cmd_ext() {
  (($#)) || usage
  PROJECT=$STATE/ext-admin; mkdir -p "$PROJECT"
  AGENTBOX_PROFILE=ext-admin; agent_home; base_env; pick_backend; resolve_net
  [[ $BACKEND == bwrap ]] || die 'ext requires the bwrap backend'
  vscode_mounts rw
  exec_sandboxed X "$BIN" --extensions-dir "$EXT_IN" "$@"
}

cmd_code() {
  parse_grants "$@"; agent_home; base_env; pick_backend; resolve_net
  [[ $BACKEND == bwrap ]] || die 'VS Code mode requires the bwrap backend'
  SECCOMP=gui   # Chromium's own sandbox needs namespaces
  vscode_mounts ro
  local cfg=$AHOME/.config/Code/User/settings.json
  [[ -e $cfg ]] || { mkdir -p "${cfg%/*}"; printf '%s\n' '{' '  "update.mode": "none",' \
    '  "extensions.autoUpdate": false,' '  "extensions.autoCheckUpdates": false' '}' >"$cfg"; }
  X+=(--ro-bind-try /sys /sys --dev-bind-try /dev/dri /dev/dri)
  local rt=/run/user/$(id -u)
  X+=(--dir "$rt" --setenv XDG_RUNTIME_DIR "$rt")
  # basic password store: no host keyring; read-only extensions: no self-updates.
  local flags=(--password-store=basic --extensions-dir "$EXT_IN" --wait --new-window)
  if [[ -n ${WAYLAND_DISPLAY:-} && -S ${XDG_RUNTIME_DIR:-}/$WAYLAND_DISPLAY ]]; then
    X+=(--ro-bind "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" "$rt/$WAYLAND_DISPLAY" --setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY")
    flags+=(--ozone-platform=wayland)
  elif [[ -n ${DISPLAY:-} ]]; then
    echo 'agentbox: WARNING: X11 lets sandboxed apps read other windows/keystrokes; prefer Wayland' >&2
    X+=(--ro-bind /tmp/.X11-unix /tmp/.X11-unix --setenv DISPLAY "$DISPLAY")
    [[ -z ${XAUTHORITY:-} ]] || X+=(--ro-bind "$XAUTHORITY" "$rt/Xauthority" --setenv XAUTHORITY "$rt/Xauthority")
  else
    die 'no Wayland or X11 display'
  fi
  exec_sandboxed X "$BIN" "${flags[@]}" "$PROJECT"
}

# Used from ~/.ssh/authorized_keys on the remote host:
#   restrict,pty,port-forwarding,permitopen="localhost:*",permitopen="127.0.0.1:*",command="~/.local/bin/agentbox gate /srv/proj" ssh-ed25519 ...
# Every session with that key (shell, VS Code Server, agents) runs sandboxed.
cmd_gate() {
  local project=${1:-}; shift || true
  parse_grants "$project" "$@"; agent_home; base_env; pick_backend; resolve_net
  local none=()
  if [[ -n ${SSH_ORIGINAL_COMMAND:-} ]]; then
    exec_sandboxed none /bin/bash -c "$SSH_ORIGINAL_COMMAND"
  else
    exec_sandboxed none /bin/bash -l
  fi
}

# Host-side git for a repo an agent could write to. Repo config that makes git
# run a command is refused (reading config never runs anything), and hooks
# never run. The landlock backend cannot make .git read-only, so use this there.
cmd_git() {
  command -v git >/dev/null || die 'git not found'
  local pre=() cfg bad
  while [[ ${1:-} == -C ]]; do pre+=(-C "$2"); shift 2; done
  cfg=$(git "${pre[@]}" config --local --no-includes --name-only --list 2>/dev/null) || cfg=''
  bad=$(grep -Ei '^(include|includeif|url|alias|credential)\.|^core\.(fsmonitor|sshcommand|pager|editor|askpass|hookspath|gitproxy|worktree|alternaterefscommand)$|^(sequence\.editor|gpg(\..*)?\.program|extensions\.worktreeconfig)$|^(uploadpack|receivepack|remote\..*\.(uploadpack|receivepack|proxy)|http\..*proxy)|^(filter|diff|merge)\..*\.(clean|smudge|process|command|textconv|driver)$' <<<"$cfg") || true
  if [[ -n $bad ]]; then
    printf 'agentbox: repo config can run commands or redirect git; inspect .git/config:\n' >&2
    printf '  %s\n' $bad >&2
    exit 1
  fi
  exec git "${pre[@]}" -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
}

# Dedicated account: a separate UID also blocks signals, ptrace, abstract
# sockets, /tmp files and the kernel keyring of your own processes.
cmd_adduser() {
  local user=${1:-} self h p d me; shift || true
  [[ $user =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || usage
  command -v setfacl >/dev/null || die 'setfacl not found (sudo apt install acl)'
  self=$(realpath -e "$0"); me=$(id -un)
  id "$user" >/dev/null 2>&1 || sudo useradd -m -s /bin/bash "$user"
  h=$(getent passwd "$user" | cut -d: -f6)
  sudo -u "$user" mkdir -p "$h/.local/bin"
  sudo install -m 755 -o "$user" "$self" "$h/.local/bin/agentbox"
  for p in "$@"; do
    p=$(realpath -e -- "$p") || die "no such dir: $p"
    # both users keep full access to everything either of them creates
    sudo setfacl -R -m "u:$user:rwX,u:$me:rwX" "$p"
    sudo find "$p" -type d -exec setfacl -m "d:u:$user:rwX,d:u:$me:rwX" {} +
    d=${p%/*}
    while [[ -n $d ]]; do sudo setfacl -m "u:$user:--x" "$d"; d=${d%/*}; done   # traverse only
    echo "granted $user: $p"
  done
  sudo -u "$user" -i "$h/.local/bin/agentbox" check
  echo "Run agents as: sudo -u $user -i agentbox PROJECT -- claude   (or put the gate line in $h/.ssh/authorized_keys)"
}

# Probes run inside the sandbox. "limit" lines are documented gaps of the
# current backend or network mode, not failures.
CHECK_PY='
import ctypes, errno, socket, subprocess, sys, random
canary, home, host_pid, fx, abstract, backend, net = sys.argv[1:8]; personal = sys.argv[8:]
libc = ctypes.CDLL(None, use_errno=True); sc = libc.syscall; sc.restype = ctypes.c_long
fail = 0
def t(name, blocked, limit=None):
    global fail
    if blocked: print("ok    " + name)
    elif limit: print("limit " + name + ": " + limit)
    else: print("FAIL  " + name); fail = 1
def denied(fn):
    try: fn(); return False
    except OSError: return True
def eperm(r): return r == -1 and ctypes.get_errno() == errno.EPERM

t("home canary unreadable", denied(lambda: open(canary).read()))
t("~/.ssh hidden", denied(lambda: os.listdir(home + "/.ssh")))
for d in personal: t(d.replace(home, "~") + " hidden", denied(lambda: os.listdir(d)))
t("/root unreadable", denied(lambda: os.listdir("/root")))
t("env secret not inherited", "AGENTBOX_TEST_SECRET" not in os.environ)
t("ssh-agent socket not inherited", "SSH_AUTH_SOCK" not in os.environ)
t("host process environ unreadable", denied(lambda: open("/proc/%s/environ" % host_pid, "rb").read()))

t("kernel keyring blocked", eperm(sc(NR["keyctl"], 0, -4, 0)))
t("ptrace blocked", eperm(sc(NR["ptrace"], 12, 0x3FFFFFFF, 0, 0)))
t("io_uring blocked", eperm(sc(NR["io_uring_setup"], 1, 0)))
t("new user namespace blocked", libc.unshare(0x10000000) != 0)
nul = os.open("/dev/null", os.O_RDWR)
t("TIOCSTI keystroke injection blocked", eperm(libc.ioctl(nul, 0x5412, ctypes.c_char_p(b"x"))))

lim = "landlock cannot protect .git; use agentbox git on the host" if backend == "landlock" else None
if os.path.isdir(fx + "/.git"):
    r = subprocess.run(["git", "-C", fx, "-c", "user.name=a", "-c", "user.email=a@b", "commit", "-q",
                        "--allow-empty", "-m", "check"], capture_output=True)
    t("agent can still commit", r.returncode == 0)
    t(".git/config read-only", denied(lambda: open(fx + "/.git/config", "a").close()), lim)
    t(".git/hooks read-only", denied(lambda: open(fx + "/.git/hooks/pre-push", "w").close()), lim)
    t(".git cannot be swapped for a fake", denied(lambda: os.rename(fx + "/.git", fx + "/.git-moved")), lim)
if backend == "bwrap":
    t("--mask hides .env", "leak" not in open(fx + "/.env").read())

s = socket.socket(socket.AF_UNIX)
t("host abstract unix socket unreachable", denied(lambda: s.connect("\0" + abstract)),
  "shared with the host; use --net proxy or a dedicated user" if net != "proxy" else None)
if net == "web":
    for _ in range(20):
        port = random.randint(20000, 29999); l = socket.socket()
        try: l.bind(("127.0.0.1", port)); l.listen(1); break
        except OSError: l.close()
    t("local service port %d unreachable" % port, denied(lambda: socket.create_connection(("127.0.0.1", port), 2)))
elif net == "open":
    t("local service ports unreachable", False, "--net open")
elif net == "proxy":
    t("direct internet unreachable", denied(lambda: socket.create_connection(("1.1.1.1", 443), 3)))
    p = socket.create_connection(("127.0.0.1", 3128), 5)
    p.sendall(b"CONNECT example.invalid:443 HTTP/1.1\r\n\r\n")
    t("proxy refuses hosts outside allowlist", b" 403 " in p.recv(200))
try:
    open(".agentbox-w", "w").close(); os.unlink(".agentbox-w"); t("project writable", True)
except OSError: t("project writable", False)
sys.exit(fail)
'

cmd_check() {
  local dir=${1:-} fixture canary lpid fail=0 abs=agentbox-check-$$ d mode net modes=(auto)
  [[ -n $dir ]] || dir=$(mktemp -d)
  export AGENTBOX_PROFILE=${AGENTBOX_PROFILE:-agentbox-check} AGENTBOX_TEST_SECRET=leak
  canary="$REAL_HOME/.agentbox-canary-$$"; fixture=$(mktemp -d)
  echo secret >"$canary"; echo 'API_KEY=leak' >"$fixture/.env"
  ! command -v git >/dev/null || git -C "$fixture" init -q
  "$PY" -I -c 'import socket,sys; s=socket.socket(socket.AF_UNIX); s.bind("\0"+sys.argv[1]); s.listen(8)
while True: s.accept()[0].close()' "$abs" & lpid=$!
  trap "rm -f '$canary'; rm -rf '$fixture'; kill $lpid 2>/dev/null" EXIT
  pick_backend; protected_paths
  [[ $BACKEND != bwrap ]] || modes+=(proxy)

  echo "== grants (host side)"
  refuse() { if (parse_grants "$@" "$dir") >/dev/null 2>&1; then echo "FAIL  grant refused: ${*: -1}"; fail=1
             else echo "ok    grant refused: ${*: -1}"; fi; }
  refuse --ro "$REAL_HOME"
  for d in .ssh .config .local/bin .bashrc; do [[ ! -e $REAL_HOME/$d ]] || refuse --ro "$REAL_HOME/$d"; done
  for d in "${PERSONAL[@]}"; do [[ ! -d $d ]] || refuse --ro "$d"; done

  local opts=(--rw "$fixture") personal=()
  [[ $BACKEND != bwrap ]] || opts+=(--mask "$fixture/.env")
  for d in "${PERSONAL[@]}"; do [[ ! -d $d ]] || personal+=("$d"); done
  for mode in "${modes[@]}"; do
    net=$mode; [[ $net != auto ]] || { ((LL_ABI >= 4)) && net=web || net=open; }
    echo "== sandbox (backend: $BACKEND, --net $net)"
    (cmd_run --net "$mode" "${opts[@]}" "$dir" -- "$PY" -I -c "$NR_PY$CHECK_PY" \
       "$canary" "$REAL_HOME" "$$" "$fixture" "$abs" "$BACKEND" "$net" "${personal[@]}") || fail=1
  done
  ((fail == 0)) || die 'sandbox checks failed; do not use'
  echo "PASS: sandbox enforced (backend: $BACKEND)"
}

case ${1:-} in
  setup) cmd_setup ;;
  ext) shift; cmd_ext "$@" ;;
  code) shift; cmd_code "$@" ;;
  gate) shift; cmd_gate "$@" ;;
  git) shift; cmd_git "$@" ;;
  check) shift; cmd_check "$@" ;;
  adduser) shift; cmd_adduser "$@" ;;
  ''|-h|--help) usage ;;
  *) cmd_run "$@" ;;
esac
